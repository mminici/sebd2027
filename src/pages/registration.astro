---
import PageBanner from "../components/PageBanner.astro";
import { dates, navigationItem, registration } from "../data";
import { formatDay } from "../lib/format";
import { sitePath } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = navigationItem("registration");
const closing = dates.find((item) => item.id === "registration");
---

<BaseLayout title={page.label} description="Fees and how to register." bleed>
	<PageBanner title={page.label} kicker={closing ? `Closes ${formatDay(closing.date)}` : undefined} />
	<div class="page-column page-body page-flow">
		<p>{registration.summary}</p>
		<section aria-labelledby="fees-title">
			<h2 id="fees-title">Fees</h2>
			<ul class="person-list">
				{
					registration.categories.map((category) => (
						<li>
							<p class="person-name">{category.name}</p>
							<p class="person-meta">{category.fee}</p>
						</li>
					))
				}
			</ul>
			{
				registration.formUrl && (
					<p class="page-action">
						<a class="btn btn-filled state-layer" href={registration.formUrl} target="_blank" rel="noopener noreferrer">
							Register
						</a>
					</p>
				)
			}
		</section>
		<p class="page-links">
			<a class="btn btn-text state-layer" href={sitePath("accommodation")}>Accommodation</a>
			<a class="btn btn-text state-layer" href={sitePath("important-dates")}>Important dates</a>
		</p>
	</div>
</BaseLayout>
