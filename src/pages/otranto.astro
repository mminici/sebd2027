---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import harbour from "../assets/otranto-harbour.jpg";
import mosaic from "../assets/otranto-mosaic.jpg";
import castle from "../assets/otranto-castle.jpg";
import lakes from "../assets/alimini-lakes.jpg";
import lecce from "../assets/lecce-duomo.jpg";
import PhotoCredit from "../components/PhotoCredit.astro";
import { Content as Intro, frontmatter as city } from "../content/otranto.md";
import { Content as Cathedral, frontmatter as cathedral } from "../content/otranto/cathedral.md";
import { Content as Castle, frontmatter as castleCopy } from "../content/otranto/castle.md";
import { Content as Lakes, frontmatter as lakesCopy } from "../content/otranto/alimini.md";
import { Content as Lecce, frontmatter as lecceCopy } from "../content/otranto/lecce.md";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Credit {
	title: string;
	imageAlt: string;
	creditName: string;
	creditLicense: string;
	creditLicenseUrl: string;
	creditSourceUrl: string;
}

interface Section {
	Content: typeof Intro;
	meta: Credit;
	image: ImageMetadata;
}

function sectionId(title: string) {
	return `${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}-title`;
}

const sections: Section[] = [
	{ Content: Cathedral, meta: cathedral as Credit, image: mosaic },
	{ Content: Castle, meta: castleCopy as Credit, image: castle },
	{ Content: Lakes, meta: lakesCopy as Credit, image: lakes },
	{ Content: Lecce, meta: lecceCopy as Credit, image: lecce },
];
---

<BaseLayout title={city.title} description="The historic center, cathedral, castle, Alimini lakes, and Lecce." bleed>
	<section class="place-hero" aria-labelledby="city-title">
		<Image
			src={harbour}
			alt={city.imageAlt}
			widths={[768, 1280, 1920]}
			sizes="100vw"
			quality={80}
			class="place-hero-photo"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="page-column place-hero-copy">
			<h1 id="city-title">{city.title}</h1>
		</div>
	</section>
	<div class="page-column page-body place-flow">
		<div class="place-lead">
			<PhotoCredit
				name={city.creditName}
				sourceUrl={city.creditSourceUrl}
				license={city.creditLicense}
				licenseUrl={city.creditLicenseUrl}
			/>
			<Intro />
		</div>
		{
			sections.map(({ Content, meta, image }) => (
				<section aria-labelledby={sectionId(meta.title)}>
					<figure class="place-figure">
						<Image
							src={image}
							alt={meta.imageAlt}
							widths={[480, 800, 1280]}
							sizes="(min-width: 42rem) 40rem, 100vw"
							class="place-photo"
							loading="lazy"
						/>
						<figcaption>
							<PhotoCredit
								name={meta.creditName}
								sourceUrl={meta.creditSourceUrl}
								license={meta.creditLicense}
								licenseUrl={meta.creditLicenseUrl}
							/>
						</figcaption>
					</figure>
					<h2 id={sectionId(meta.title)}>{meta.title}</h2>
					<Content />
				</section>
			))
		}
	</div>
</BaseLayout>
